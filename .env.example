# ==============================================================================
# AI CAD Platform — Environment Configuration Template
# ==============================================================================

# Global Environment (dev, staging, prod)
ENV=dev
DEBUG=true

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=aicad
POSTGRES_PASSWORD=aicad_secret
POSTGRES_DB=aicad_db

# Redis Cache
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# RabbitMQ Messaging
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest

# MinIO (S3 Object Storage)
MINIO_ENDPOINT=http://localhost:9000
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_CAD_BUCKET=aicad-models

# ClickHouse Analytics
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse_secret
CLICKHOUSE_DB=aicad_analytics

# API Gateway (Kong)
GATEWAY_PUBLIC_PORT=8000
GATEWAY_ADMIN_PORT=8001

# Security & Auth
JWT_SECRET=super_secret_jwt_key_at_least_256_bits_long_for_security_12345
JWT_EXPIRATION_SECONDS=86400

# LLM Providers (for llm-service)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
