# LLM Service Configuration
ENV=dev
DEBUG=false
PORT=8000
HOST=0.0.0.0

# LLM Provider Selection: gemini | groq | openai | anthropic | ollama | deepseek
LLM_PROVIDER=gemini

# OpenAI (Supports official API or custom base URL like OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_FAST_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
ANTHROPIC_FAST_MODEL=claude-3-5-haiku-20241022

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FAST_MODEL=gemini-2.0-flash

# Groq (Ultra-fast LPU inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FAST_MODEL=deepseek-chat

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b

# CAD Service Integration (for server-side compile validation & auto-repair)
CAD_SERVICE_URL=http://localhost:8002
AUTO_REPAIR_CAD_ERRORS=true

# CORS (comma-separated origins or * for all)
CORS_ORIGINS=*

# Redis Caching (set REDIS_URL in cloud hosting or leave CACHE_ENABLED=false without Redis)
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
CACHE_ENABLED=false
CACHE_TTL_SECONDS=86400

# RabbitMQ Messaging (set RABBITMQ_URL for CloudAMQP or host/port/user/pass locally)
RABBITMQ_URL=
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_EVENTS_EXCHANGE=aicad.events
RABBITMQ_ENABLED=false
