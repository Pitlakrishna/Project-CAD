# LLM Service Configuration
ENV=dev
DEBUG=true
PORT=8000
HOST=0.0.0.0

# LLM Provider Selection: gemini | groq | openai | anthropic | ollama | deepseek
LLM_PROVIDER=gemini

# OpenAI (Supports official API or custom base URL like Groq, OpenRouter)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Google Gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Groq (Ultra-fast LPU inference)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_FAST_MODEL=llama-3.1-8b-instant

# DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_FAST_MODEL=deepseek-chat

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b

# Redis Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

# RabbitMQ Messaging
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_EVENTS_EXCHANGE=aicad.events
RABBITMQ_ENABLED=false
