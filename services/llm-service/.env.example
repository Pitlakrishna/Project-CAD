# LLM Service Configuration
ENV=dev
DEBUG=true
PORT=8000
HOST=0.0.0.0

# LLM Provider Selection: openai | anthropic | ollama | mock
LLM_PROVIDER=mock

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# Ollama (Local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-coder:6.7b

# Redis Caching
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

# RabbitMQ Messaging
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_EVENTS_EXCHANGE=aicad.events
RABBITMQ_ENABLED=false
