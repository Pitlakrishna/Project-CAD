#!/usr/bin/env bash
# Pre-commit hook to verify no committed secrets and valid formatting
echo "==> Running pre-commit checks..."

# Check for staged .env files
if git diff --cached --name-only | grep -E "^(\.env|\.env\..+)$" | grep -v "\.env\.example"; then
  echo "ERROR: Attempting to commit an environment file (.env)! Aborting."
  exit 1
fi

echo "Pre-commit checks passed."
exit 0
