# Public LLM Backend URL (Gateway or llm-service URL)
# Example for Render: https://aicad-llm-service.onrender.com
NEXT_PUBLIC_BACKEND_URL=http://127.0.0.1:8000

# Server-side CAD Service URL used by Next.js /api/cad/* proxy routes
# Example for Render: https://aicad-cad-service.onrender.com
CAD_SERVICE_URL=http://127.0.0.1:8002

# Optional public CAD Service URL (allows direct browser-to-CAD requests, bypassing Vercel proxy timeout)
NEXT_PUBLIC_CAD_SERVICE_URL=

# Optional contact email displayed in the Sponsored/Ads panel
NEXT_PUBLIC_CONTACT_EMAIL=

